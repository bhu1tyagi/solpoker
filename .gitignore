node_modules/
target/
.anchor/
dist/
.env
.DS_Store

# Never commit wallet material. keys/ holds throwaway devnet test wallets only.
# target/deploy/*-keypair.json is the program's upgrade authority and is covered
# by the target/ rule above. There used to be a re-inclusion rule here; it was
# inert (git cannot re-include under an excluded directory) but it was one edit
# away from publishing the deploy key, which is not a line worth keeping.
keys/
*.pem

# Rust build artifacts and local bench state
program-id.json
hand-history.json

# Local security reports. These list unfixed weaknesses; publishing them
# alongside the source would hand an attacker the roadmap.
.superstack/

# Next.js app
app/.next/
app/out/
app/next-env.d.ts
*.tsbuildinfo
app/.env.local
.agents/
.claude/
skills-lock.json

# Vercel's project link. The client's Root Directory is `app`, so a manual
# deploy runs from here and drops the link at the root as well as under app/.
.vercel
