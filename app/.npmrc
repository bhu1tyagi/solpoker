# npm tries to install @vercel/speed-insights's OPTIONAL peers — including
# @sveltejs/kit, which this app does not use and which drags in vite 8 against
# the vite 7 vitest needs. The install fails on that conflict, locally and on
# Vercel identically. This flag skips peer auto-resolution; it lives in a file
# rather than in a command so the build server resolves exactly as we do.
legacy-peer-deps=true
